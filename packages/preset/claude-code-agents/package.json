{
  "name": "@deepseek-ai/dsh-claude-code-agents",
  "description": "Load Claude Code `.claude/agents` definitions as agent presets for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/claude-code-agents"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./parse": {
      "types": "./lib/types/parse.d.ts",
      "default": "./lib/parse.js"
    },
    "./restrict": {
      "types": "./lib/types/restrict.d.ts",
      "default": "./lib/restrict.js"
    },
    "./discovery": {
      "types": "./lib/types/discovery.d.ts",
      "default": "./lib/discovery.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/parse.js",
    "lib/restrict.js",
    "lib/discovery.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/invariant.js"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  }
}
